---
const currentPath = Astro.url.pathname;
const isActive = (path: string) => currentPath === path || currentPath.startsWith(path + '/');
---
<header class="site-header">
  <div class="container">
    <a href="/" class="logo">🧮 CalculatorTaxePFA.eu</a>
    <nav>
      <a href="/calculator/" class:list={[{ 'text-blue': isActive('/calculator') }]}>Calculator</a>
      <a href="/calculator/pfa-vs-srl/" class:list={[{ 'text-blue': isActive('/calculator/pfa-vs-srl') }]}>PFA vs SRL</a>
      <a href="/blog/" class:list={[{ 'text-blue': isActive('/blog') }]}>Blog</a>
      <a href="/calculator/" class="btn" style="padding:.5rem 1rem;font-size:.875rem">Calculează →</a>
    </nav>
  </div>
</header>

<style>
  .text-blue { color: var(--blue) !important; }
</style>
